# Copy to .env for local runs. Never commit .env.

# OpenAI (use a dedicated project key with a hard monthly budget set in the OpenAI dashboard)
OPENAI_API_KEY=sk-...
# Checked on 2026-11-05 against https://developers.openai.com/api/docs/pricing
# gpt-6-luna was the cheapest chat model in the Standard table: $0.10 in, $0.50 out per 1M tokens.
LLM_MODEL=gpt-6-luna
EMBEDDING_MODEL=text-embedding-3-small
PRICE_IN_PER_1M=0.10
PRICE_OUT_PER_1M=0.50
PRICE_EMBED_PER_1M=0.02

# Supabase (service role key: server side only, never in the browser)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Demo page
ALLOWED_ORIGINS=http://localhost:8000
DEMO_ACCESS_CODE=change-me
DEFAULT_SITE_ID=
DAILY_MESSAGE_CAP=300
MIN_SIMILARITY=0.30

# Offline mode for local UI work and tests (no API key, no database):
# LLM_PROVIDER=fake
# STORE=memory
